# Addresses the application answers on (comma-separated).
# Caddy issues the certificate for them; other host names get an empty response.
HEX_HOSTS=localhost, 192.168.1.50

# Certificate served when the browser connects by bare IP (no SNI).
HEX_DEFAULT_SNI=192.168.1.50

# Which local address Caddy listens on (ports 80/443).
#   127.0.0.1    — this computer only (default)
#   192.168.1.50 — this computer + your local network (Caddy won't start if the IP changes)
#   0.0.0.0      — every network the computer joins, e.g. hotel Wi-Fi (Docker bypasses the firewall)
HEX_BIND=127.0.0.1
